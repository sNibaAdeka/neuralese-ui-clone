# Godot 4+ specific ignores
.godot/
/android/

# FullyLocal runtime artifacts
/local_runtime/python/
# A developer runtime may link to a task-scoped venv outside the checkout.
/local_runtime/python
/local_runtime/tmp_smoke_job/
/local_runtime/tmp*/
/local_runtime/tmp_*
/local_runtime/**/__pycache__/
# Emulator checkouts for the robot tests: nested git clones, fetched locally
/local_runtime/.emulators/
**/__pycache__/
.pytest_cache/
/.runtime_payload_build/
/ui_captures/
/addons/**/~*.TMP

# Private source snapshot: keep local/runtime artifacts out of commits.
.env
.env.*
*.pyc
*.pyo
*.log
*.tmp
*.bak
/venv/
/.venv/
/security_secrets_and_access.md
/runtime_payload/*.zip
/local_runtime/tools.zip
/.ci/neuralese-setup-source.zip
