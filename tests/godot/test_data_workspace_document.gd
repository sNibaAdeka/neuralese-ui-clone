extends SceneTree

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var Doc = load("res://scripts/data_workspace/document.gd")
	var IO = load("res://scripts/data_workspace/import_export.gd")
	assert(Doc != null and IO != null)
	var numeric = Doc.new()
	numeric.create("Numbers")
	numeric.generate(40, 123)
	var same = Doc.new()
	same.create("Same")
	same.generate(40, 123)
	assert(numeric.values(0) == same.values(0), "Seed reproduces synthetic examples")
	var original: Array = numeric.values(0)
	numeric.set_value(0, 0, -0.67)
	assert(absf(float(numeric.value(0, 0)) + 0.67) < 0.00001)
	numeric.undo()
	assert(numeric.values(0) == original)
	numeric.redo()
	assert(absf(float(numeric.value(0, 0)) + 0.67) < 0.00001)
	var split: String = numeric.split_for(0)
	numeric.augment([0], 2, 7)
	assert(numeric.split_for(40) == split and numeric.split_for(41) == split, "Copies cannot leak across train/validation")
	numeric.delete_rows([1, 2])
	assert(numeric.split_for(38) == split)
	assert(numeric.add_class("Third"))
	numeric.assign_class([0], "Third")
	assert(numeric.group_for(0) == "Third")
	assert(numeric.rename_class("Third", "Renamed"))
	assert(numeric.group_for(0) == "Renamed")
	assert(numeric.quality().errors.is_empty())
	assert(numeric.add_input("temperature"))
	assert(numeric.rename_input(2, "heat"))
	assert(numeric.field_name(2) == "heat" and numeric.value(0, 2) == 0.0)
	numeric.numeric_answers()
	assert(numeric.column_count() == 4 and numeric.studio().classes.is_empty())
	assert(numeric.quality().errors.is_empty())
	numeric.undo()
	assert(not numeric.studio().classes.is_empty())
	var car = Doc.new()
	car.create("Car", "car")
	car.generate(30, 42)
	var steering: float = float(car.value(0, 5))
	car.augment([0], 1)
	assert(absf(float(car.value(30, 5)) + steering) < 0.00001, "Mirroring also mirrors the steering target")
	var packed = Doc.new()
	packed.attach({"name": "packed", "storage": "packed_float32", "values": PackedFloat32Array([1, 2, 3, 4]), "row_count": 2, "column_count": 2, "col_names": ["x:float", "target:float"], "outputs_from": 1})
	packed.set_value(0, 0, 9)
	assert(packed.data.storage == "packed_float32" and not packed.data.has("arr"), "Packed data stays packed")
	assert(packed.value(0, 0) == 9.0)
	packed.undo()
	assert(packed.value(0, 0) == 1.0)
	var images = Doc.new()
	images.create("Pictures", "images")
	images.generate(4, 42)
	assert(images.value(0, 0) is Texture2D)
	var first_pixels: PackedByteArray = images.value(0, 0).get_image().get_data()
	assert(IO.export_file(images, "user://studio-roundtrip.json") == OK)
	var imported: Dictionary = IO.read_table("user://studio-roundtrip.json")
	assert(not imported.has("error"))
	var restored = Doc.new()
	restored.attach(imported.dataset)
	assert(restored.row_count() == 4)
	assert(restored.value(0, 0).get_image().get_data() == first_pixels)
	var csv := FileAccess.open("user://studio-quoted.csv", FileAccess.WRITE)
	csv.store_string("x,y,label\n1,2,\"class, one\"\n3,4,class2\n")
	csv.close()
	var table: Dictionary = IO.read_table("user://studio-quoted.csv")
	assert(not table.has("error"))
	var table_doc = Doc.new(); table_doc.attach(table.dataset)
	assert(table_doc.row_count() == 2 and table_doc.classes().has("class, one"))
	print("PASS test_data_workspace_document")
	quit(0)
